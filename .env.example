# Sample. ./init.sh copies it to .env, fills in USER_ID/GROUP_ID/SHARED_GID
# and replaces every __GENERATE__ with a random secret (64 hex characters).

########## Machine-specific ##########

# Compose project name (lowercase): prefix for volumes, the network and images, and the traefik label value.
# Two environments on one machine differ by this name, CONTAINER_PREFIX, the subnet and the ports
COMPOSE_PROJECT_NAME=devkit
# Container name prefix, to avoid clashing with foreign containers (REDIS, TRAEFIK, etc.)
CONTAINER_PREFIX=DEVKIT_
# Services: db, mysql, mongo, rabbitmq, mail, s3, git, git-mcp, tools.
# Runtime images for projects: php, node, go, python, java, rust.
# Traefik always runs.
COMPOSE_PROFILES=db,tools
# Local zone: services are available as portainer.<DOMAIN>, git.<DOMAIN>, etc.
DOMAIN=alp

# Ports on the host
HTTP_PORT=80
HTTPS_PORT=443
PGSQL_PORT=5432
REDIS_PORT=6379
MYSQL_PORT=3306
MONGO_PORT=27017
RABBITMQ_PORT=5672

# Network. The first two octets of the /16 subnet; traefik gets ${SUBNET_PREFIX}.0.100.
# init.sh picks a subnet that no other docker network uses
NETWORK_NAME="${COMPOSE_PROJECT_NAME}_local_network"
SUBNET_PREFIX=172.29

# Owner of files on the host (id -u / id -g)
USER_ID=1000
GROUP_ID=1000
# Group that owns a shared code folder (vboxsf in VirtualBox): projects add it through group_add.
# No shared folder: same as GROUP_ID
SHARED_GID=1000

# Where projects live (used in include paths)
SITES_PATH="./Sites"

########## Secrets ##########

PGSQL_ROOT_USER=pgsql
PGSQL_ROOT_PASSWORD=__GENERATE__
MEILI_MASTER_KEY=__GENERATE__
MYSQL_ROOT_PASSWORD=__GENERATE__
MONGO_ROOT_USER=mongo
MONGO_ROOT_PASSWORD=__GENERATE__
RABBITMQ_USER=rabbitmq
RABBITMQ_PASSWORD=__GENERATE__
# Garage requires exactly 64 hex characters
GARAGE_RPC_SECRET=__GENERATE__
GARAGE_ADMIN_TOKEN=__GENERATE__
# git-mcp profile: a random path segment and a token created in Forgejo by hand
GIT_MCP_PATH_KEY=__GENERATE__
FORGEJOMCP_TOKEN=

########## Usually left as is ##########

CONTAINERS_ROOT_PATH="./Containers"
STORAGE_ROOT_PATH="./storage"

#Traefik
TRAEFIK_CONTAINER_NAME="${CONTAINER_PREFIX}TRAEFIK"
TRAEFIK_STORAGE_PATH="${STORAGE_ROOT_PATH}/Traefik"

#Portainer
PORTAINER_CONTAINER_NAME="${CONTAINER_PREFIX}PORTAINER"

#Redis
REDIS_CONTAINER_NAME="${CONTAINER_PREFIX}REDIS"
REDISINSIGHT_CONTAINER_NAME="${CONTAINER_PREFIX}REDISINSIGHT"

#MeiliSearch
MEILISEARCH_CONTAINER_NAME="${CONTAINER_PREFIX}MEILISEARCH"

#PostgreSQL
PGSQL_CONTAINER_NAME="${CONTAINER_PREFIX}PGSQL_DB"
PGSQL_STORAGE_PATH="${STORAGE_ROOT_PATH}/PgSQL"

#MySQL
MYSQL_CONTAINER_NAME="${CONTAINER_PREFIX}MYSQL_DB"

#MongoDB
MONGO_CONTAINER_NAME="${CONTAINER_PREFIX}MONGO_DB"

#RabbitMQ
RABBITMQ_CONTAINER_NAME="${CONTAINER_PREFIX}RABBITMQ"

#Mailpit
MAILPIT_CONTAINER_NAME="${CONTAINER_PREFIX}MAILPIT"

#Garage (S3)
GARAGE_CONTAINER_NAME="${CONTAINER_PREFIX}GARAGE_S3"

#Forgejo (git)
FORGEJO_CONTAINER_NAME="${CONTAINER_PREFIX}FORGEJO_GIT"
FORGEJO_MCP_CONTAINER_NAME="${CONTAINER_PREFIX}FORGEJO_MCP"

