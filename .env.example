# Образец. ./init.sh копирует его в .env, подставляет USER_ID/GROUP_ID/SHARED_GID
# и заменяет каждое __GENERATE__ случайным секретом (64 hex-символа).

########## Меняется под машину ##########

# Имя compose-проекта (строчные буквы): префикс томов, сети и образов, метка для traefik.
# Два окружения на одной машине различаются этим именем, CONTAINER_PREFIX, подсетью и портами
COMPOSE_PROJECT_NAME=devkit
# Префикс имён контейнеров, чтобы не пересечься с чужими (REDIS, TRAEFIK и т.п.)
CONTAINER_PREFIX=DEVKIT_
# Сервисы: db, s3, git, git-mcp, tools. Образы рантаймов для проектов: php, node, go, python, java.
# Traefik работает всегда.
COMPOSE_PROFILES=db,tools
# Локальная зона: сервисы доступны как portainer.<DOMAIN>, git.<DOMAIN> и т.д.
DOMAIN=alp

# Порты на хосте
HTTP_PORT=80
HTTPS_PORT=443
PGSQL_PORT=5432
REDIS_PORT=6379

# Сеть. Первые два октета подсети /16; traefik получает ${SUBNET_PREFIX}.0.100.
# init.sh подбирает подсеть, не занятую другими сетями docker
NETWORK_NAME="${COMPOSE_PROJECT_NAME}_local_network"
SUBNET_PREFIX=172.29

# Владелец файлов на хосте (id -u / id -g)
USER_ID=1000
GROUP_ID=1000
# Группа-владелец общей папки с кодом (vboxsf в VirtualBox): проекты добавляют её через group_add.
# Нет общей папки: то же, что GROUP_ID
SHARED_GID=1000

# Где лежат проекты (используется в путях include)
SITES_PATH="./Sites"

########## Секреты ##########

PGSQL_ROOT_USER=pgsql
PGSQL_ROOT_PASSWORD=__GENERATE__
MEILI_MASTER_KEY=__GENERATE__
# Garage требует ровно 64 hex-символа
GARAGE_RPC_SECRET=__GENERATE__
GARAGE_ADMIN_TOKEN=__GENERATE__
# Профиль git-mcp: случайный сегмент пути и токен, созданный в Forgejo вручную
GIT_MCP_PATH_KEY=__GENERATE__
FORGEJOMCP_TOKEN=

########## Обычно не трогают ##########

CONTAINERS_ROOT_PATH="./Containers"
STORAGE_ROOT_PATH="./storage"

#Traefik
TRAEFIK_CONTAINER_NAME="${CONTAINER_PREFIX}TRAEFIK"
TRAEFIK_STORAGE_PATH="${STORAGE_ROOT_PATH}/Traefik"

#Portainer
PORTAINER_CONTAINER_NAME="${CONTAINER_PREFIX}PORTAINER"

#Redis
REDIS_CONTAINER_NAME="${CONTAINER_PREFIX}REDIS"
REDISINSIGHT_CONTAINER_NAME="${CONTAINER_PREFIX}REDISINSIGHT"

#MeiliSearch
MEILISEARCH_CONTAINER_NAME="${CONTAINER_PREFIX}MEILISEARCH"

#PostgreSQL
PGSQL_CONTAINER_NAME="${CONTAINER_PREFIX}PGSQL_DB"
PGSQL_STORAGE_PATH="${STORAGE_ROOT_PATH}/PgSQL"

#Garage (S3)
GARAGE_CONTAINER_NAME="${CONTAINER_PREFIX}GARAGE_S3"

#Forgejo (git)
FORGEJO_CONTAINER_NAME="${CONTAINER_PREFIX}FORGEJO_GIT"
FORGEJO_MCP_CONTAINER_NAME="${CONTAINER_PREFIX}FORGEJO_MCP"

